#!/usr/bin/env bash
set -euo pipefail
shopt -s nullglob

usage() {
  cat >&2 <<'EOF'
usage: claude-sessions         pick a session with fzf (if installed), else list the last 10
       claude-sessions -a      list all sessions (--all)
       claude-sessions <id>    resume a session in its folder (a unique ID prefix is enough)
EOF
  exit "${1:-1}"
}
[[ ${1:-} == -h || ${1:-} == --help ]] && usage 0
command -v jq >/dev/null || { echo "claude-sessions: jq is required" >&2; exit 1; }

cd "${CLAUDE_CONFIG_DIR:-$HOME/.claude}/projects" 2>/dev/null || exit 0

files=(./*/*.jsonl)
(( ${#files[@]} )) || exit 0

sorted=()
while read -r f; do sorted+=("$f"); done < <(ls -t "${files[@]}")

row() {
  local f=$1 cwd title
  IFS=$'\t' read -r cwd title < <({ head -n 100 "$f"; grep -E '"type":"(custom|ai)-title"' "$f"; } | jq -rs '
    [ (map(.cwd // empty) | first // "?"),
      ((map(.customTitle // empty) | last)
       // (map(.aiTitle // empty) | last)
       // (map(select(.type == "user") | .message.content
              | if type == "array" then map(select(.type == "text") | .text) | join(" ") else . end
              | select(type == "string" and length > 0 and (startswith("<") | not))) | first)
       // "" | gsub("\\s+"; " ") | .[0:70]) ] | @tsv' 2>/dev/null || echo "?")
  printf '%s  %-36s  %s  %s\n' "$(date -r "$f" '+%Y-%m-%d %H:%M')" "${cwd/#$HOME/\~}" "$(basename "$f" .jsonl)" "${title:-}"
}

list() {
  local f
  for f in "${sorted[@]:0:$1}"; do
    row "$f"
  done
}

resume() {
  local matches=(./*/"$1"*.jsonl) f cwd
  (( ${#matches[@]} )) || { echo "claude-sessions: no session $1" >&2; exit 1; }
  (( ${#matches[@]} == 1 )) || { echo "claude-sessions: $1 matches ${#matches[@]} sessions, use more of the ID" >&2; exit 1; }
  f=${matches[0]}
  cwd=$(head -n 100 "$f" | jq -rs 'map(.cwd // empty) | first // empty')
  [[ -n $cwd ]] || { echo "claude-sessions: no folder recorded for session $1" >&2; exit 1; }
  cd "$cwd"
  exec claude --resume "$(basename "$f" .jsonl)"
}

case "${1:-}" in
  -a|--all) list "${#sorted[@]}" ;;
  "")
    if command -v fzf >/dev/null && [[ -t 0 && -t 1 ]]; then
      pick=$(list "${#sorted[@]}" | fzf --no-sort --layout=reverse --prompt='resume> ') || exit 0
      resume "$(grep -oE '[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}' <<<"$pick" | head -n 1)"
    else
      list 10
    fi
    ;;
  -*|*[!0-9a-f-]*) usage ;;
  *) resume "$1" ;;
esac
