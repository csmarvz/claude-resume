#!/usr/bin/env bash
set -euo pipefail
shopt -s nullglob

usage() {
  cat >&2 <<'EOF'
usage: claude-resume              pick a session with fzf (if installed), else list the last 10
       claude-resume -a           list all sessions (--all)
       claude-resume <id>         resume a session in its folder (a unique ID prefix is enough)
       claude-resume -d [-y] <id> delete a session for good; asks first unless -y (--delete, --yes)
EOF
  exit "${1:-1}"
}
die() { echo "claude-resume: $*" >&2; exit 1; }

uuid='^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$'
yes=
target=
case "${1:-}" in
  -h|--help) usage 0 ;;
  ""|-a|--all) ;;
  --preview) [[ ${2:-} =~ ^[0-9a-f-]+$ ]] || usage ;;
  -d|--delete)
    for arg in "${@:2}"; do
      case $arg in
        -y|--yes) yes=yes ;;
        *) [[ -z $target ]] || usage; target=$arg ;;
      esac
    done
    [[ $target =~ ^[0-9a-f-]+$ ]] || usage
    [[ -z $yes || $target =~ $uuid ]] || die "-y needs the full session ID"
    ;;
  -*|*[!0-9a-f-]*) usage ;;
esac
command -v jq >/dev/null || die "jq is required"

self="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/${BASH_SOURCE[0]##*/}"
config=${CLAUDE_CONFIG_DIR:-$HOME/.claude}
config=$(cd "$config" 2>/dev/null && pwd) || die "no sessions found in ${CLAUDE_CONFIG_DIR:-$HOME/.claude}/projects"
projects=$config/projects
cd "$projects" 2>/dev/null || die "no sessions found in $projects"

scan() {
  local files=(./*/????????-????-????-????-????????????.jsonl) f
  sorted=()
  (( ${#files[@]} )) || return 0
  while read -r f; do sorted+=("$f"); done < <(ls -t "${files[@]}")
}
scan
(( ${#sorted[@]} )) || die "no sessions found in $projects"

tilde() {
  if [[ $1 == "$HOME" || $1 == "$HOME"/* ]]; then printf '%s' "~${1#"$HOME"}"; else printf '%s' "$1"; fi
}

parse() { jq -nRr "[inputs | fromjson? | objects] | $1"; }

info() {
  { head -n 100 "$1"; grep -E '"type":"(custom|ai)-title"' "$1" || true; } | parse '
    [ (map(.cwd // empty) | first // "?"),
      ((map(.customTitle // empty) | last)
       // (map(.aiTitle // empty) | last)
       // (map(select(.type == "user") | .message.content
              | if type == "array" then map(select(.type == "text") | .text) | join(" ") else . end
              | select(type == "string" and length > 0 and (startswith("<") | not))) | first)
       // "" | gsub("\\s+"; " ")) ] | join("\t")'
}

session() {
  local f matches=()
  for f in "${sorted[@]}"; do
    if [[ ${f##*/} == "$1"* ]]; then matches+=("$f"); fi
  done
  (( ${#matches[@]} )) || die "no session $1"
  for f in "${matches[@]}"; do
    [[ ${f##*/} == "${matches[0]##*/}" ]] || die "$1 matches ${#matches[@]} sessions, use more of the ID"
  done
  echo "${matches[0]}"
}

list() {
  local f id cwd title i tw=0 cw=0
  local dates=() titles=() cwds=() ids=()
  for f in "${sorted[@]:0:$1}"; do
    IFS=$'\t' read -r cwd title < <(info "$f")
    title=${title:0:50}
    if [[ $cwd == "$HOME" || $cwd == "$HOME"/* ]]; then cwd="~${cwd#"$HOME"}"; fi
    id=${f##*/}
    dates+=("$(date -r "$f" '+%Y-%m-%d %H:%M')")
    titles+=("$title")
    cwds+=("$cwd")
    ids+=("${id%.jsonl}")
    tw=$(( ${#title} > tw ? ${#title} : tw ))
    cw=$(( ${#cwd} > cw ? ${#cwd} : cw ))
  done
  for i in "${!ids[@]}"; do
    printf '%s  %s%*s  %s%*s  %s\n' "${dates[i]}" \
      "${titles[i]}" $((tw - ${#titles[i]})) '' \
      "${cwds[i]}" $((cw - ${#cwds[i]})) '' \
      "${ids[i]}"
  done
}

preview() {
  local f cwd title id
  f=$(session "$1")
  IFS=$'\t' read -r cwd title < <(info "$f")
  cwd=$(tilde "$cwd")
  id=${f##*/}
  printf '\033[1m%s\033[0m\n\033[2m%s  ·  %s  ·  %s\033[0m\n\n' \
    "${title:-(untitled)}" "$cwd" "$(date -r "$f" '+%Y-%m-%d %H:%M')" "${id%.jsonl}"

  printf '\033[1mLast reply\033[0m\n'
  { grep '"type":"assistant"' "$f" || true; } | tail -n 50 | parse '
    map(.message.content | arrays | map(select(.type == "text") | .text) | join("\n") | select(length > 0))
    | last // "(none)" | .[0:1500]'

  printf '\n\033[1mPrompts\033[0m\n'
  { grep '"type":"user"' "$f" | grep -v '"type":"tool_result"' || true; } | parse '
    map(select(.isMeta != true and .isCompactSummary != true) | .message.content
        | if type == "array" then map(select(.type == "text") | .text) | join(" ") else . end
        | select(type == "string" and length > 0 and (startswith("<") | not))
        | gsub("\\s+"; " ") | .[0:300])
    | reduce .[] as $p ([]; if index([$p]) then . else . + [$p] end)
    | if length == 0 then "(none)" else map("› " + .) | join("\n") end'
}

open_pid() {
  local f pid
  for f in "$config"/sessions/*.json; do
    [[ $(jq -r '.sessionId // empty' "$f" 2>/dev/null) == "$1" ]] || continue
    pid=${f##*/}
    pid=${pid%.json}
    if kill -0 "$pid" 2>/dev/null && ps -ww -p "$pid" -o args= 2>/dev/null | grep -qi claude; then
      echo "$pid"
      return 0
    fi
  done
  return 0
}

u='─'
if (( ${#u} == 1 )); then
  tl='╭' tr='╮' bl='╰' br='╯' bv='│' bh='─' ell='…' arrows='←→' dot='·'
else
  tl='+' tr='+' bl='+' br='+' bv='|' bh='-' ell='~' arrows='<>' dot='-'
fi

row() {
  local s=$2
  if (( ${#s} > inner )); then s="${s:0:inner-1}$ell"; fi
  printf '\033[%d;%dH\033[31m%s\033[0m \033[%sm%s\033[0m\033[%d;%dH\033[31m%s\033[0m\033[K' \
    "$r" "$left" "$bv" "$1" "$s" "$r" $(( left + w - 1 )) "$bv"
  r=$(( r + 1 ))
}

dialog() {
  local size rows cols w inner avail tail pad n h top left r i line label hint lpad b0 b1 gap
  size=$(stty size </dev/tty 2>/dev/null) || size=
  rows=${size% *}
  cols=${size#* }
  if ! [[ $rows =~ ^[1-9][0-9]*$ && $cols =~ ^[1-9][0-9]*$ ]]; then rows=24 cols=80; fi
  w=$(( cols - 4 < 96 ? cols - 4 : 96 ))
  if (( w < 30 )); then w=$(( cols < 30 ? cols : 30 )); fi
  inner=$(( w - 4 ))
  avail=$(( rows - 2 ))
  tail=1
  if (( avail >= 4 )); then tail=2; fi
  pad=0
  if (( avail - tail >= ${#lines[@]} + 2 )); then pad=1; fi
  n=$(( avail - tail - 2 * pad ))
  if (( n > ${#lines[@]} )); then n=${#lines[@]}; fi
  if (( n < 0 )); then n=0; fi
  while (( n > 0 )) && [[ -z ${lines[n-1]} ]]; do n=$(( n - 1 )); done
  h=$(( n + tail + 2 * pad + 2 ))
  top=$(( rows > h ? (rows - h) / 2 + 1 : 1 ))
  left=$(( cols > w ? (cols - w) / 2 + 1 : 1 ))

  line=$(printf '%*s' $(( w - 2 )) '')
  line=${line// /$bh}
  label=" Delete session "
  hint=" $arrows select $dot ENTER choose $dot ESC cancel "
  if (( ${#label} > w - 4 )); then label=""; fi
  if (( ${#hint} > w - 6 )); then hint=""; fi
  r=$top
  printf '\033[2J\033[%d;%dH\033[31m%s%s%s%s%s\033[0m' "$r" "$left" "$tl" "$bh$bh" "$label" "${line:0:w-4-${#label}}" "$tr"
  r=$(( r + 1 ))
  if (( pad )); then row 0 ""; fi
  for (( i = 0; i < n; i++ )); do row "${styles[i]}" "${lines[i]}"; done
  if (( tail == 2 )); then row 0 ""; fi
  if (( inner >= 24 )); then b0='[ CANCEL ]' b1='[ CONFIRM ]' gap='   '; else b0='[CANCEL]' b1='[CONFIRM]' gap=' '; fi
  lpad=$(( (inner - ${#b0} - ${#gap} - ${#b1}) / 2 ))
  if (( lpad < 0 )); then lpad=0; fi
  printf '\033[%d;%dH\033[31m%s\033[0m %*s' "$r" "$left" "$bv" "$lpad" ''
  if (( sel == 0 )); then printf '\033[7m%s\033[0m%s\033[31m%s\033[0m' "$b0" "$gap" "$b1"; else printf '%s%s\033[1;7;31m%s\033[0m' "$b0" "$gap" "$b1"; fi
  printf '\033[%d;%dH\033[31m%s\033[0m\033[K' "$r" $(( left + w - 1 )) "$bv"
  r=$(( r + 1 ))
  if (( pad )); then row 0 ""; fi
  printf '\033[%d;%dH\033[31m%s%s%s%s%s\033[0m' "$r" "$left" "$bl" "$bh$bh" "$hint" "${line:0:w-4-${#hint}}" "$br"
}

confirm() {
  local lines=() styles=() st s key rest old rc size drawn= sel=0 intr=0 idle=0
  while IFS=$'\t' read -r st s; do styles+=("$st"); lines+=("$s"); done <<<"$1"
  old=$(stty -g </dev/tty)
  stty -icanon -echo min 0 time 0 </dev/tty
  cat </dev/tty >/dev/null
  stty "$old" </dev/tty
  printf '\033[?1049h\033[?25l' >/dev/tty
  trap 'printf "\033[?25h\033[?1049l" >/dev/tty; stty "$old" </dev/tty' EXIT
  trap 'intr=1' INT
  trap 'exit 143' TERM
  while :; do
    size=$(stty size </dev/tty 2>/dev/null) || size=
    if [[ $size != "$drawn" ]]; then
      dialog >/dev/tty
      drawn=$size
    fi
    rc=0
    IFS= read -rsn1 -t 1 key </dev/tty || rc=$?
    if (( intr )); then sel=0; break; fi
    if (( rc )); then
      idle=$(( idle + 1 ))
      if (( idle > 600 )); then sel=0; break; fi
      continue
    fi
    idle=0
    drawn=
    case $key in
      $'\033')
        stty -icanon -echo min 0 time 1 </dev/tty
        rest=$(dd bs=1 count=2 2>/dev/null </dev/tty) || rest=
        stty "$old" </dev/tty
        case $rest in
          '[D'|'OD') sel=0 ;;
          '[C'|'OC') sel=1 ;;
          '') sel=0; break ;;
        esac
        ;;
      '') break ;;
      q) sel=0; break ;;
    esac
  done
  printf '\033[?25h\033[?1049l' >/dev/tty
  trap - EXIT INT TERM WINCH
  (( sel == 1 ))
}

delete() {
  local f id cwd title pid p details paths=()
  if ! f=$(session "$1" 2>&1); then
    msg=${f#claude-resume: }
    return 1
  fi
  id=${f##*/}
  id=${id%.jsonl}
  if ! [[ $id =~ $uuid && -f $f ]]; then
    msg="Not deleted: unexpected session file $f"
    return 1
  fi
  pid=$(open_pid "$id")
  if [[ -n $pid ]]; then
    msg="Not deleted: session ${id:0:8} is open in Claude Code (pid $pid). Close it first."
    return 1
  fi
  IFS=$'\t' read -r cwd title < <(info "$f")
  f=${f#./}
  for p in "$projects/$f" "$projects/${f%.jsonl}" "$config/file-history/$id" "$config/session-env/$id"; do
    if [[ ( -e $p || -L $p ) && ( ${p##*/} == "$id" || ${p##*/} == "$id.jsonl" ) ]]; then paths+=("$p"); fi
  done
  if (( ${#paths[@]} == 0 )); then
    msg="Not deleted: no files found for session $id"
    return 1
  fi

  details=$(printf '1;31\tWARNING: this permanently deletes the session below. It cannot be undone.\n0\t\n1\t%s\n2\t%s  ·  %s  ·  %s\n0\t\n0\tFiles to delete in %s:' \
    "${title:-(untitled)}" "$(tilde "$cwd")" "$(date -r "$projects/$f" '+%Y-%m-%d %H:%M')" "$id" "$(tilde "$config")")
  for p in "${paths[@]}"; do
    details+=$(printf '\n0\t  %6s  %s' "$(du -sh "$p" 2>/dev/null | cut -f1)" "${p#"$config"/}")
  done

  if [[ ${2:-} != yes ]] && ! confirm "$details"; then
    msg="Cancelled, nothing was deleted."
    return 1
  fi
  pid=$(open_pid "$id")
  if [[ -n $pid ]]; then
    msg="Not deleted: session ${id:0:8} was opened in Claude Code (pid $pid). Close it first."
    return 1
  fi
  if ! rm -rf -- "${paths[@]}"; then
    msg="Only partly deleted \"${title:-$id}\", see the errors above."
    return 1
  fi
  msg="Deleted \"${title:-$id}\"."
}

resume() {
  local f cwd
  f=$(session "$1")
  cwd=$(head -n 100 "$f" | parse 'map(.cwd // empty) | first // empty')
  [[ -n $cwd ]] || die "no folder recorded for session $1"
  cd "$cwd" 2>/dev/null || die "folder $cwd no longer exists"
  f=${f##*/}
  exec claude --resume "${f%.jsonl}"
}

pick() {
  local msg= query= pos=0 canpos= v rows out rc key id rest opts
  v=$(fzf --version 2>/dev/null) || v=
  if [[ $v =~ ^([0-9]+)\.([0-9]+) ]] && (( BASH_REMATCH[1] > 0 || BASH_REMATCH[2] >= 38 )); then canpos=yes; fi
  while :; do
    rows=$(list "${#sorted[@]}")
    opts=()
    if [[ -n $canpos ]] && (( pos > 1 )); then opts=(--bind "load:pos($pos)"); fi
    rc=0
    out=$(printf '%s\n' "$rows" | fzf --no-sort --no-multi --layout=reverse --prompt='search> ' \
      --print-query --query "$query" --expect ctrl-d ${opts[@]+"${opts[@]}"} \
      --header "type to search · ↑↓ select · ENTER resume session · CTRL-D delete · ESC quit${msg:+$'\n'$msg}" \
      --preview "$(printf '%q' "$self") --preview {-1}" --preview-window 'down,60%,wrap') || rc=$?
    case $rc in
      0) ;;
      1) query=${out%%$'\n'*}; pos=0; continue ;;
      130) exit 0 ;;
      *) die "fzf exited with status $rc" ;;
    esac
    id=${out##*$'\n'}
    id=${id##* }
    rest=${out%$'\n'*}
    key=${rest##*$'\n'}
    rest=${rest%$'\n'*}
    query=${rest##*$'\n'}
    if [[ $key != ctrl-d ]]; then
      resume "$id"
    else
      pos=$(printf '%s\n' "$rows" | FZF_DEFAULT_OPTS= fzf --no-sort --filter "$query" | grep -n -F "$id" | head -n 1 | cut -d: -f1) || pos=0
      delete "$id" || true
      scan
      (( ${#sorted[@]} )) || { echo "$msg"; exit 0; }
    fi
  done
}

case "${1:-}" in
  -a|--all) list "${#sorted[@]}" ;;
  --preview) preview "$2" ;;
  -d|--delete)
    [[ -n $yes || -t 0 ]] || die "deleting needs a terminal to confirm; add -y to skip the confirmation"
    msg=
    delete "$target" "$yes" || die "$msg"
    echo "$msg"
    ;;
  "")
    if command -v fzf >/dev/null && [[ -t 0 && -t 1 ]]; then
      pick
    else
      list 10
    fi
    ;;
  *) resume "$1" ;;
esac
